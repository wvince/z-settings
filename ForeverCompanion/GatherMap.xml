<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- Point de récolte sur la carte du monde (GatherMap.lua : ForeverCompanionNodePinMixin) -->
  <Frame name="ForeverCompanionNodePinTemplate" mixin="ForeverCompanionNodePinMixin" virtual="true" enableMouse="true">
    <Size x="14" y="14"/>
    <Layers>
      <Layer level="ARTWORK">
        <Texture parentKey="Icon" setAllPoints="true"/>
      </Layer>
    </Layers>
    <!-- Pas de OnEnter / OnLeave ici : la carte du jeu l'interdit (assertion dans AcquirePin) et
         appelle elle-même OnMouseEnter / OnMouseLeave du mixin. -->
    <Scripts>
      <OnLoad method="OnLoad"/>
    </Scripts>
  </Frame>
</Ui>
