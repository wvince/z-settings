#!/bin/sh
# Writes Z-Settings/ZBundle.lua on every commit:
#   Z_VARS      each addon's SavedVariables names, read from the tocs (the client won't return them)
#   Z_VARS_ID   a checksum of Z_VARS; /z export records the one the game had loaded
#   Z_CHARVARS  each addon's SavedVariablesPerCharacter names, for /z save and /z copy
#   Z_BUNDLE    the latest /z export, which WoW writes to WTF\...\SavedVariables at /reload
# Addon folders git ignores are never shared, so they are left out of both lists. The commit is
# refused when the export was made before a shared addon (or its names) arrived, so it misses that
# addon's settings, or when nothing at all changed.
set -e
root=$(git rev-parse --show-toplevel)
sv=$(ls -t "$root"/../../WTF/Account/*/SavedVariables/Z-Settings.lua 2>/dev/null | head -n 1)
text=$( [ -n "$sv" ] && grep -o '\["export"\] = "ZS1:[A-Za-z0-9+/=]*"' "$sv" | sed 's/.*= "//; s/"$//' || true)
if [ -z "$text" ]; then
  echo "No Z-Settings export found. In game: /z export, then publish again." >&2
  exit 1
fi
exported=$(grep -o '\["exportVars"\] = "[^"]*"' "$sv" | head -n 1 | sed 's/.*= "//; s/"$//' || true)
# table <global> <toc field>: every addon's names in that field, all flavors' tocs merged
table() {
  echo "$1 = {"
  for dir in "$root"/*/; do
    addon=$(basename "$dir")
    git -C "$root" check-ignore -q "$addon/" && continue
    names=$(cat "$dir"*.toc 2>/dev/null | tr -d '\r' | sed -n "s/^## *$2 *: *//p" |
      tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' | sort -u |
      sed 's/.*/"&"/' | paste -sd, - || true)
    [ -n "$names" ] && echo "  [\"$addon\"] = { $names },"
  done
  echo "}"
}
vars=$(table Z_VARS SavedVariables)
id=$(printf '%s\n' "$vars" | cksum | cut -d' ' -f1)
out="$root/Z-Settings/ZBundle.lua"
# The Z_VARS the game had loaded at the export: the bundle carrying the exported id, as it stands
# before this run rewrites it or in any commit. A shared addon line missing from it is an addon whose
# settings the export lacks; addons gone since, or ignored, don't matter.
loaded=$(mktemp)
trap 'rm -f "$loaded"' EXIT
if [ -n "$exported" ]; then
  for rev in worktree $(git -C "$root" log --format=%H -- Z-Settings/ZBundle.lua); do
    if [ "$rev" = worktree ]; then cat "$out" 2>/dev/null || true
    else git -C "$root" show "$rev:Z-Settings/ZBundle.lua"; fi | tr -d '\r' > "$loaded"
    grep -qxF "Z_VARS_ID = \"$exported\"" "$loaded" && break
    : > "$loaded"
  done
fi
missing=$(printf '%s\n' "$vars" | grep '^  \[' | grep -vxF -f "$loaded" |
  sed 's/^  \["\([^"]*\)"\].*/\1/' | paste -sd' ' - || true)
{
  echo "-- Written by the commit hook. Edits here are overwritten."
  printf '%s\n' "$vars"
  printf 'Z_VARS_ID = "%s"\n' "$id"
  table Z_CHARVARS SavedVariablesPerCharacter
  printf 'Z_BUNDLE = "%s"\n' "$text"
} > "$out"
if [ ! -s "$loaded" ] || [ -n "$missing" ]; then
  if [ -s "$loaded" ]; then
    echo "Your last export was made before these addons were added: $missing" >&2
  else
    echo "Your last export was made before Z-Settings knew your addons' settings names." >&2
  fi
  echo "In game: /reload, then /z export. Then publish again." >&2
  exit 1
fi
git add "$out"
# publishing runs with --allow-empty so the hook always gets to bundle the export; nothing new is no commit
if git diff --cached --quiet; then
  echo "Nothing new to publish: the setup and the addons are what's already committed." >&2
  exit 1
fi
